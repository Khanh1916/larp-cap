# Copy to .env (or set in your hosting dashboard). Never commit real values.
PORT=3000
# "production" enables secure cookies, HSTS and disables demo shortcuts.
NODE_ENV=development
# Long random string used to sign the session cookie (required in production).
SESSION_SECRET=change-me-to-a-long-random-string
# "true" re-enables 1-click demo login / switch account even in production.
DEMO_LOGIN=false
# SQLite file location (default ./cap.db); point it at a persistent disk in production.
CAP_DB_PATH=
